# Create ~/laravel/.env once on the class VPS. Never commit the filled file.
# GitHub Actions preserves this file; Docker does not use it.
APP_NAME=JobConnect
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://jobconnect.austattendance.online
FRONTEND_URL=http://jobconnect.austattendance.online
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=jobconnect_db
DB_USERNAME=jobconnect
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set true when using HTTPS and update APP_URL/FRONTEND_URL too.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# log records email locally. Set up SMTP to deliver email.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@jobconnect.austattendance.online
MAIL_FROM_NAME=JobConnect

PAYMENTS_MODE=demo
ADMIN_EMAIL=
ADMIN_PASSWORD=
