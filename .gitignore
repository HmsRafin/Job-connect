# JobConnect — root ignores
# Env & secrets (keep .example files)
.env
.env.vps
.env.local
.env.production
*.key
*.pem
*.p12

# Docker volumes (persisted data)
backend/database/database.sqlite
backend/storage/app/public/*
!backend/storage/app/public/.gitignore

# OS / Editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.tmp
*.swp

# Node / vendor (already ignored in sub-projects, but safe here)
node_modules/
dist/
vendor/
/backend/public/app/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
.env.*
!.env.*.example
!**/.env.example
Keys/
.tools/
*credentials*
playwright-report/
test-results/
.next/
release*.tar.gz
